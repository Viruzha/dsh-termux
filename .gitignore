# ── 绝不入库：密钥与个人数据 ──────────────────────────────
config/credentials.yaml
config/sessions/
config/attachments/
/data/          # 只忽略仓库根部的 data/，别误伤源码里的 data 包
*.keystore

# ── 生成物与备份 ─────────────────────────────────────────
*.tar.zst
*.zst
*.orig
*.bak
*.log
.DS_Store

# ── 可重新下载的大件（apps/ 下的工程不携带这些）──────────
apps/apk-lab/sdk/platforms/*/android.jar
apps/apk-lab/apktool-test/framework/
apps/apk-lab/apktool-test/apktool.jar
apps/apk-lab/dl/
apps/*/local.properties
apps/*/build/
# ⚠️ 构建产物绝不入库：APK 里内嵌了 token（default_token 字符串资源）
#    曾经漏在这里，导致真实 token 进了历史，只能轮换
apps/wake-app/dist/
apps/hub/dist/
# hub 的运行时从仓库 runtime/ 暂存，不重复入库
apps/hub/assets/
apps/apk-lab/gradle-test/**/build/
apps/apk-lab/gradle-test/.gradle/

# 拼豆工程的构建产物与 SDK 指针
apps/pingdou/app/build/
apps/pingdou/local.properties
apps/pingdou/.gradle/
