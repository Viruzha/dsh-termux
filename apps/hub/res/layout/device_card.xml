<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_marginBottom="12dp"
    android:padding="18dp" android:background="@drawable/card">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <View android:id="@+id/d_dot" android:layout_width="9dp" android:layout_height="9dp"
            android:background="@drawable/dot_off" />
        <TextView android:id="@+id/d_name" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginLeft="10dp" android:textSize="17sp"
            android:textStyle="bold" android:textColor="@color/text" />
        <TextView android:id="@+id/d_state" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/text_dim" />
    </LinearLayout>

    <TextView android:id="@+id/d_mac" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:layout_marginLeft="19dp"
        android:textSize="12sp" android:textColor="@color/text_faint" android:letterSpacing="0.05" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="15dp">
        <TextView android:id="@+id/d_wake" android:layout_width="0dp" android:layout_height="46dp"
            android:layout_weight="1" android:background="@drawable/btn_wake_sel" android:gravity="center"
            android:text="@string/btn_wake" android:textSize="15sp" android:textStyle="bold"
            android:textColor="#FF06150D" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/d_check" android:layout_width="0dp" android:layout_height="46dp"
            android:layout_weight="1" android:layout_marginLeft="10dp" android:background="@drawable/btn_ghost"
            android:gravity="center" android:text="@string/btn_check" android:textSize="15sp"
            android:textColor="@color/text" android:clickable="true" android:focusable="true" />
    </LinearLayout>
</LinearLayout>
