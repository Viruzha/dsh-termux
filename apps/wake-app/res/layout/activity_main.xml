<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_app">

    <FrameLayout android:id="@+id/content"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" />

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/border" />

    <LinearLayout android:id="@+id/nav"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="@color/nav_bg"
        android:paddingTop="6dp" android:paddingBottom="6dp"
        android:paddingLeft="10dp" android:paddingRight="10dp" />
</LinearLayout>
